class MainActivity : Activity() {
    private val bg = Color.rgb(13, 15, 20)
    private val panel = Color.rgb(26, 29, 37)
    private val red = Color.rgb(235, 55, 65)
    private val white = Color.rgb(245, 246, 250)
    private val muted = Color.rgb(170, 176, 190)
    private lateinit var statusText: TextView
    private lateinit var checksText: TextView
    private lateinit var logText: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        render()
        runChecks()
    }

    private fun render() {
        val scroll = ScrollView(this).apply { setBackgroundColor(bg) }
        val page = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(20), dp(26), dp(20), dp(28))
        }
        scroll.addView(page)
        page.addView(label("🛡  JuniorGuarD PRO", 27, white, true))
        page.addView(label("PAINEL DE SEGURANÇA DO DISPOSITIVO", 11, red, true).also {
            it.setPadding(0, dp(5), 0, dp(20))
        })
        val statusCard = card()
        statusCard.addView(label("STATUS DO PAINEL", 12, muted, true))
        statusText = label("Verificando configurações…", 19, white, true)
        statusText.setPadding(0, dp(9), 0, dp(4))
        statusCard.addView(statusText)
        statusCard.addView(label("Este app faz verificações básicas locais; não é antivírus e não bloqueia ataques de rede.", 13, muted, false))
        page.addView(statusCard, matchWrap())

        page.addView(sectionTitle("VERIFICAÇÕES"))
        val checksCard = card()
        checksText = label("Aguardando verificações…", 14, white, false)
        checksCard.addView(checksText)
        page.addView(checksCard, matchWrap())

        page.addView(sectionTitle("FERRAMENTAS"))
        page.addView(actionButton("↻  Atualizar verificações") { runChecks() })
        page.addView(actionButton("⚙  Abrir configurações de segurança") {
            try {
                startActivity(android.content.Intent(android.provider.Settings.ACTION_SECURITY_SETTINGS))
            } catch (_: Exception) {
                Toast.makeText(this, "Não foi possível abrir as configurações.", Toast.LENGTH_SHORT).show()
            }
        })
        page.addView(actionButton("ℹ  Sobre o JuniorGuarD PRO") {
            Toast.makeText(this, "Versão 1.0 • Painel local de diagnóstico", Toast.LENGTH_LONG).show()
        })

        page.addView(sectionTitle("REGISTRO"))
        val logCard = card()
        logText = label("O registro será atualizado após cada verificação.", 13, muted, false)
        logCard.addView(logText)
        page.addView(logCard, matchWrap())
        page.addView(label("Privacidade: esta versão não envia dados para servidores e não solicita permissões especiais.", 12, muted, false).apply {
            setPadding(dp(2), dp(18), dp(2), 0)
        })
        setContentView(scroll)
    }

    private fun runChecks() {
        val lines = mutableListOf<String>()
        lines += "✓ Aplicativo aberto e executando"
        lines += "✓ Sem permissões especiais solicitadas"
        val cm = getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
        val network = cm.activeNetwork
        val caps = if (network != null) cm.getNetworkCapabilities(network) else null
        val hasInternet = caps?.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) == true
        lines += (if (hasInternet) "• Rede com acesso à internet disponível" else "• Nenhuma rede com internet detectada")
        lines += "• VPN: verifique manualmente nas configurações do Android"
        lines += "• Atualizações do sistema: verifique em Configurações > Sistema"
        checksText.text = lines.joinToString("\\n\\n")
        statusText.text = if (hasInternet) "Painel ativo • Verificação concluída" else "Painel ativo • Rede não detectada"
        logText.text = "Última verificação concluída agora.\\nNenhuma tentativa de invasão foi medida por este app."
        Toast.makeText(this, "Verificações locais concluídas", Toast.LENGTH_SHORT).show()
    }

    private fun card() = LinearLayout(this).apply {
        orientation = LinearLayout.VERTICAL
        setPadding(dp(16), dp(16), dp(16), dp(16))
        setBackgroundColor(panel)
    }
    private fun sectionTitle(text: String) {
        // Helper retained for simple layout building; see addSection below.
    }
    private fun addSection(page: LinearLayout, text: String) {
        page.addView(label(text, 15, white, true).apply { setPadding(0, dp(22), 0, dp(10)) })
    }
    private fun label(text: String, size: Int, color: Int, bold: Boolean) = TextView(this).apply {
        this.text = text
        textSize = size.toFloat()
        setTextColor(color)
        if (bold) typeface = Typeface.DEFAULT_BOLD
        setLineSpacing(dp(3).toFloat(), 1f)
    }
    private fun actionButton(text: String, action: () -> Unit) = Button(this).apply {
        this.text = text
        setTextColor(white)
        setBackgroundColor(Color.rgb(105, 25, 34))
        isAllCaps = false
        gravity = Gravity.CENTER
        setPadding(dp(12), dp(9), dp(12), dp(9))
        setOnClickListener { action() }
        val p = LinearLayout.LayoutParams(-1, -2)
        p.bottomMargin = dp(9)
        layoutParams = p
    }
    private fun matchWrap() = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(8) }
    private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
}
